# ==========================================
# MigrateIQ Configuration Environment Variables
# ==========================================

# Application Settings
ENVIRONMENT=development
LOG_LEVEL=INFO
APP_HOST=0.0.0.0
APP_PORT=8000
STREAMLIT_PORT=8501

# LLM Providers (Configure at least one or use local mock)
# Primary: Groq (Llama 3.3 70B)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# Portkey Gateway (Optional)
PORTKEY_API_KEY=
PORTKEY_VIRTUAL_KEY=

# Google Gemini (for embeddings and fallback generation)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# Vector Database (Local fallback or Qdrant Cloud)
VECTOR_DB_TYPE=local # options: local, qdrant, hana
QDRANT_URL=https://your-cluster-id.us-east4-0.gcp.cloud.qdrant.io:6333
QDRANT_API_KEY=your_qdrant_api_key_here
QDRANT_COLLECTION=sap_migration_docs

# SAP HANA Cloud (Optional Layer 3)
HANA_ADDRESS=
HANA_PORT=443
HANA_USER=
HANA_PASSWORD=

# SQLite Results Database
DATABASE_URL=sqlite:///./results.db

# Observability (Optional)
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LOGFIRE_TOKEN=
